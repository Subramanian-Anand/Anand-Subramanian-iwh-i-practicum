
doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body 
        h1 Add a New Pet
        .cards
            .card
                form(method='POST', action='/update-cobj')
                    label(for='name') Name:
                    input#name(type='text', name='name', required)

                    label(for='age') Age:
                    input#age(type='number', name='age', required)
                    
                    label(for='type') Type:
                    input#type(type='text', name='type', required)
                    
                    button(type='submit') Create Pet
                    
                    a.back-btn(href='/') Return to the homepage