
doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body 
        h1 Custom Object Table (Pets)

        div.table-section
            a.update-cobj-link(href="/update-cobj") Add to this table

            table
                thead
                    tr
                        th Name
                        th Age
                        th Type
                tbody
                    each pet in data
                        tr
                            td= pet.properties.pet_name
                            td= pet.properties.age
                            td= pet.properties.type